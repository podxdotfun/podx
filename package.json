{
    "name": "podx-workspace",
    "private": true,
    "packageManager": "npm@10.8.3",
    "workspaces": [
        "frontend",
        "server"
    ],
    "scripts": {
        "preinstall": "npx only-allow npm",
        "build": "cd frontend && npm install && npm run build",
        "dev": "cd frontend && npm run dev",
        "start": "cd frontend && npm start"
    },
    "engines": {
        "node": ">=22.9.0",
        "npm": ">=10.8.3"
    },
    "corepack": {
        "enabled": true,
        "preferredPackageManager": "npm@10.8.3"
    }
} 